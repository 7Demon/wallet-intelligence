# =============================================================================
# Wallet Intelligence — Environment Configuration Template
# =============================================================================

# Database
DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/wallet_intelligence
DATABASE_URL_SYNC=postgresql://postgres@localhost:5432/wallet_intelligence

# Solana RPC Endpoint (Gunakan Helius/QuickNode free key untuk kecepatan sync & bypass 429 rate limit)
# Example Helius: https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Configuration paths
CLASSIFICATION_CONFIG_PATH=./config/classification_thresholds.json

# API Settings
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Webhook & Admin Security
# HELIUS_WEBHOOK_SECRET=your_helius_webhook_secret_here
# APP_ADMIN_SECRET=your_admin_secret_here
